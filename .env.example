# Neon Postgres pooled connection string. Keep server-only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Use a long, unique password. It signs a 12-hour HttpOnly admin cookie.
ADMIN_PASSWORD=replace-with-at-least-12-random-characters

# Random secret used only to HMAC-hash rate-limit identities before storage.
RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Optional Meta WhatsApp Cloud API owner notification.
# All six variables must be configured or notification sending is skipped.
WHATSAPP_GRAPH_VERSION=vXX.X
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Digits only. Use an opted-in owner/operations number, not the API sender.
WHATSAPP_OWNER_NUMBER=919876543210
WHATSAPP_TEMPLATE_NAME=driveway_kustoms_new_booking
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# The approved template must contain exactly eight BODY text variables in order:
# 1 booking code, 2 customer name, 3 phone, 4 vehicle/category/model/registration,
# 5 services summary, 6 total, 7 schedule, 8 full address.
# Suggested Utility template body:
# New Driveway Kustoms booking {{1}}.
# Customer: {{2}} | Phone: {{3}}
# Vehicle: {{4}}
# Services: {{5}} | Estimated total: {{6}}
# Schedule: {{7}} | Address: {{8}}
